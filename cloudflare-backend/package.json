{
  "name": "campus-market-backend",
  "version": "1.0.0",
  "description": "High-performance Cloudflare Workers & D1 edge backend for Campus Market",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute campus-market-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute campus-market-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.114.0"
  }
}
